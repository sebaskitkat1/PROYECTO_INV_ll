# Copia este archivo como .env y ajusta los valores a tu instalacion.
# La app usa MySQL si la conexion funciona; si no, abre en modo ejemplo
# (solo lectura, sin guardar cambios).
#
# No subas el .env real al repositorio: contiene la contrasena.
DB_HOST=localhost
DB_PORT=3306
DB_USER=cosecha_app
DB_PASSWORD=
DB_NAME=frutidata
# Exige TLS al conectar a MySQL (recomendado si la base no es local).
DB_SSL=0
# Conexiones simultaneas del pool.
DB_POOL_SIZE=4

# Cajero automatico de demostracion (scripts/cajero_diario.py).
# Sin COSECHA_ENTORNO=demo el cajero no escribe en la base.
# Descomenta solo en entornos de prueba, nunca en produccion.
# COSECHA_ENTORNO=demo
# CAJERO_CORREO=caja@frutidata.local
# CAJERO_ADMIN_CORREO=admin@frutidata.local
